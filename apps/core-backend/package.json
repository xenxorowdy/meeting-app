{
  "name": "@kesami/core-backend",
  "version": "1.0.0",
  "description": "Rust core engine and hosted provider relay for the Kesami meeting assistant",
  "type": "commonjs",
  "scripts": {
    "start": "cargo run --release --manifest-path Cargo.toml",
    "dev": "cargo run --manifest-path Cargo.toml",
    "start:cloud": "cargo run --release --manifest-path Cargo.toml --no-default-features --bin kesami-cloud-relay",
    "test": "cargo test --manifest-path Cargo.toml",
    "migrate:users": "cargo run --manifest-path Cargo.toml -- --migrate-users",
    "migrate:billing": "cargo run --manifest-path Cargo.toml -- --migrate-billing",
    "build": "cargo build --release --manifest-path Cargo.toml",
    "test:cloud": "cargo test --manifest-path Cargo.toml --no-default-features --bin kesami-cloud-relay"
  },
  "keywords": [
    "meeting-assistant",
    "audio-dsp",
    "vad",
    "whisper",
    "diarization",
    "screencapturekit",
    "wasapi",
    "claude-ai",
    "sqlite-fts"
  ],
  "author": "Kesami Engineering Team",
  "license": "Commercial"
}
