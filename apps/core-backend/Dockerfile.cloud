FROM rust:1.98-trixie AS builder

WORKDIR /build

COPY apps/core-backend/Cargo.toml apps/core-backend/Cargo.lock ./
RUN mkdir -p src/bin \
    && echo "fn main() {}" > src/main.rs \
    && echo "fn main() {}" > src/bin/kesami-cloud-relay.rs \
    && touch src/lib.rs \
    && cargo build --release --locked --no-default-features --bin kesami-cloud-relay \
    && rm -rf src

COPY apps/core-backend/src ./src
COPY apps/core-backend/migrations ./migrations
RUN touch src/lib.rs src/bin/kesami-cloud-relay.rs && cargo build --release --locked --no-default-features --bin kesami-cloud-relay

FROM debian:trixie-slim

RUN useradd --system --no-create-home --shell /usr/sbin/nologin kesami
COPY --from=builder /build/target/release/kesami-cloud-relay /usr/local/bin/kesami-cloud-relay
USER kesami
ENV HOST=0.0.0.0
EXPOSE 48901
CMD ["kesami-cloud-relay"]
