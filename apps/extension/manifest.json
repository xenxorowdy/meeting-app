{
    "manifest_version": 3,
    "name": "Kesami Meeting Names",
    "version": "1.0.0",
    "description": "Reads the participant list and the speaking indicator out of Google Meet and Zoom, and hands them to the Kesami meeting assistant running on this machine.",
    "minimum_chrome_version": "102",
    "permissions": ["storage"],
    "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
    "background": {
        "service_worker": "src/background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://meet.google.com/*"],
            "js": ["src/content/observer.js", "src/content/meet.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://*.zoom.us/*", "https://*.zoomgov.com/*"],
            "js": ["src/content/observer.js", "src/content/zoom.js"],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "Kesami Meeting Names",
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
